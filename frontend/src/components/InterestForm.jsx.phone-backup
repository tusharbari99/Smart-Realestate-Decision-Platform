import { useState } from "react";

import api from "../services/api";

const requestOptions = [
  {
    value: "Property Details",
    label: "Details",
  },
  {
    value: "Book Site Visit",
    label: "Site Visit",
  },
  {
    value: "Price Discussion",
    label: "Price Talk",
  },
];

function InterestForm({ propertyId }) {
  const [requestType, setRequestType] = useState("Property Details");
  const [contactNumber, setContactNumber] = useState("");
  const [message, setMessage] = useState("");
  const [sending, setSending] = useState(false);
  const [status, setStatus] = useState(null);

  async function handleSubmit(event) {
    event.preventDefault();

    if (!contactNumber.trim()) {
      setStatus({
        type: "error",
        text: "Please enter your mobile number.",
      });
      return;
    }

    try {
      setSending(true);
      setStatus(null);

      const fullMessage = [
        `Request: ${requestType}`,
        `Mobile Number: ${contactNumber.trim()}`,
        `Message: ${
          message.trim() ||
          "I need more information about this property."
        }`,
      ].join("\n");

      await api.post("/inquiries", {
        property_id: Number(propertyId),
        message: fullMessage,
      });

      setStatus({
        type: "success",
        text: "Request received. Our team will contact you soon.",
      });

      setMessage("");
    } catch (error) {
      setStatus({
        type: "error",
        text:
          error.response?.data?.message ||
          "Request failed. Please try again.",
      });
    } finally {
      setSending(false);
    }
  }

  return (
    <div className="mt-4 rounded-2xl border border-blue-100 bg-blue-50/70 p-4">
      <h3 className="text-lg font-black text-slate-900">
        Choose What You Need
      </h3>

      <p className="mt-1 text-sm text-slate-600">
        Our team will guide you.
      </p>

      <form onSubmit={handleSubmit}>
        <div className="mt-4 grid grid-cols-3 gap-2">
          {requestOptions.map((option) => (
            <button
              key={option.value}
              type="button"
              onClick={() => setRequestType(option.value)}
              className={`min-h-14 rounded-xl border px-2 py-2 text-xs font-bold leading-4 transition ${
                requestType === option.value
                  ? "border-blue-600 bg-blue-600 text-white"
                  : "border-slate-300 bg-white text-slate-700 hover:border-blue-400"
              }`}
            >
              {option.label}
            </button>
          ))}
        </div>

        <input
          type="tel"
          value={contactNumber}
          onChange={(event) => setContactNumber(event.target.value)}
          placeholder="Mobile number"
          className="mt-4 w-full rounded-xl border border-slate-300 bg-white p-3 text-sm outline-none focus:border-blue-500"
        />

        <textarea
          rows={3}
          value={message}
          onChange={(event) => setMessage(event.target.value)}
          placeholder="Your question"
          className="mt-3 w-full resize-none rounded-xl border border-slate-300 bg-white p-3 text-sm outline-none focus:border-blue-500"
        />

        {status && (
          <p
            className={`mt-3 rounded-xl px-3 py-2 text-sm font-semibold ${
              status.type === "success"
                ? "bg-emerald-100 text-emerald-700"
                : "bg-red-100 text-red-700"
            }`}
          >
            {status.text}
          </p>
        )}

        <button
          type="submit"
          disabled={sending}
          className="mt-4 w-full rounded-xl bg-emerald-600 px-4 py-3 font-extrabold text-white transition hover:bg-emerald-700 disabled:opacity-60"
        >
          {sending ? "Sending..." : "Send Request"}
        </button>
      </form>
    </div>
  );
}

export default InterestForm;
